# MongoDB Atlas connection string
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog?authSource=admin

# Secret used to sign login JWTs — set this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Render sets this automatically — only needed for local dev if you
# want a specific port
PORT=5000

# Cloudinary (free tier) — used for image/favicon uploads
# Get these from https://cloudinary.com/console after signing up free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
